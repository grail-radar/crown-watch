{
  "name": "@crown-watch/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "echo \"(api lint not configured yet)\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "ingest:rss": "ts-node --transpile-only src/scripts/poll-rss.ts",
    "extract": "ts-node --transpile-only src/scripts/extract.ts",
    "extract:verify": "ts-node --transpile-only src/scripts/extract-verify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
