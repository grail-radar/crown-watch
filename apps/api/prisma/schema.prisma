// Crown Watch data model — see CONTEXT.md §5.
// Table/column names are snake_case (mapped) to match the brief; Prisma model
// and field names stay camelCase for idiomatic client usage.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum SourceType {
  rss
  newsletter
  kickstarter
  site_watch
  manual
}

enum SourceHealth {
  unknown
  healthy
  degraded
  error
  // The store answered fine, but the poll refused to publish what it found —
  // an implausible number of changes at once means something upstream is wrong,
  // and a Channel cannot unsend. Deliberately not `error`: nothing is broken,
  // the source is held until a human looks at it. See `lastError` for why, and
  // docs/operations/site-watch-runbook.md for how to release it.
  held
}

// What a store product turned out to be. A brand's feed returns everything the
// shop sells, and a strap is not a watch release — see ADR-0006.
enum WatchKind {
  watch
  accessory
}

// Whether a human has approved what we say about a Brand.
//
// `listed` is the honest default and not a lesser tier: the Brand is fully
// visible, fully alerted on, and simply has no judgement attached yet. Breadth
// and honesty are not in tension (CONTEXT.md §2) — what must never happen is
// silence reading as endorsement.
//
// Replaces `watchlist|verified`. "Watchlist" is a *user's* list of Brands they
// follow and never a state a Brand is in (CONTEXT.md §9), and "verified"
// claimed something nobody had checked.
enum BrandStatus {
  listed
  curated
}

enum DropType {
  kickstarter_launch
  waitlist_open
  restock
  pre_order
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum PlanTier {
  free
  paid
}

enum SubscriptionStatus {
  incomplete
  trialing
  active
  past_due
  canceled
}

enum NotificationChannelType {
  email
  telegram
  discord
}

enum BroadcastStatus {
  // Claimed but not yet resolved. A row left `pending` means the process died
  // between claiming and hearing back from Telegram — the message may or may
  // not have landed, so it is never retried (see DropBroadcast).
  pending
  sent
  failed
}

// ── Ingestion ────────────────────────────────────────────────────────────

model Source {
  id           String       @id @default(cuid())
  type         SourceType
  name         String?
  brandId      String?      @map("brand_id")
  endpoint     String
  // Tier 4 only: which store adapter to use and its settings, e.g.
  // { "adapter": "shopify_products_json", "currency": "EUR" }. Keeping this as
  // data means adding a brand on a supported platform needs no code change.
  watchConfig  Json?        @map("watch_config")
  lastPolledAt DateTime?    @map("last_polled_at")
  healthStatus SourceHealth @default(unknown) @map("health_status")
  // Politeness state. A store that errors or rate-limits us is asking to be
  // left alone for a while; persisting that request is what makes it survive a
  // restart, which an in-memory backoff would not.
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  nextAttemptAt       DateTime? @map("next_attempt_at")
  /// Why the source is unhealthy, so an operator can see it without logs.
  lastError           String?   @map("last_error")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  brand  Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  events RawIngestionEvent[]

  @@unique([type, endpoint])
  @@index([type])
  @@index([brandId])
  @@map("sources")
}

model RawIngestionEvent {
  id          String   @id @default(cuid())
  sourceId    String   @map("source_id")
  fetchedAt   DateTime @default(now()) @map("fetched_at")
  // Raw fetched content is never discarded — needed to reprocess as extraction
  // prompts improve (CONTEXT.md §5).
  rawPayload  Json     @map("raw_payload")
  contentHash String   @map("content_hash")
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  drops  Drop[]

  @@unique([sourceId, contentHash])
  @@index([processed])
  @@index([sourceId])
  @@map("raw_ingestion_events")
}

// ── Catalog ──────────────────────────────────────────────────────────────

model Brand {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  website          String?
  instagramHandle  String?     @map("instagram_handle")
  country          String?
  foundedYearEst   Int?        @map("founded_year_est")
  status           BrandStatus @default(listed)
  /// The one honest sentence about this Brand, including the unflattering ones
  /// — the differentiator a larger competitor's database does not have
  /// (CONTEXT.md §2). Never purchasable, in any form (ADR-0004).
  ///
  /// Present while `status` is still `listed` means a **draft**: written, not
  /// yet approved, and shown to nobody. Only a Curated Brand displays one.
  annotation           String?
  /// When a human approved the Annotation. Null until one does — nothing
  /// automatic ever sets it, which is what keeps `curated` meaningful.
  annotationApprovedAt DateTime? @map("annotation_approved_at")
  // Phase 2 — brand reliability / delivery track-record (CONTEXT.md §2, §5).
  reliabilityScore Float?      @map("reliability_score")
  // How many times the enrichment pass has asked a model about this brand.
  // Most brands will never have all three details — an obscure microbrand often
  // has no published founding year — so "still missing something" is not a
  // usable work queue on its own: the pass would re-ask about the same oldest
  // brands forever and never reach a newly discovered one. Counting attempts is
  // what lets it give up and move on.
  enrichmentAttempts  Int       @default(0) @map("enrichment_attempts")
  enrichmentAskedAt   DateTime? @map("enrichment_asked_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  sources    Source[]
  drops      Drop[]
  watchlists Watchlist[]
  watches    Watch[]
  groupingOverrides WatchGroupingOverride[]

  @@index([status])
  @@map("brands")
}

// One model a brand makes — the durable object a reader searches for and lands
// on, as opposed to a Drop, which is an event that happened to it.
//
// A store product is NOT a watch: YEMA lists the Superman Bronze CMM.10 as three
// products, one per bracelet reference. Those are three Variants of one Watch,
// and collapsing them is what stops the same watch being announced three times
// (ADR-0003).
model Watch {
  id      String @id @default(cuid())
  brandId String @map("brand_id")
  // The grouping key from `site-watch/watch-identity.ts`. Stored rather than
  // recomputed so a later change to the rule cannot silently re-partition a
  // catalogue that is already published and linked to.
  key     String
  slug    String
  name    String
  /// A watch, or something the shop sells alongside them. Only a watch raises
  /// a Drop. Stored rather than derived so it can be queried (ADR-0006), and
  /// rewritten by every poll unless `kindOverride` says otherwise.
  kind         WatchKind  @default(watch)
  /// An operator's correction; null means "trust the rule". Never written by a
  /// poll — the rule does not get to overturn a human.
  kindOverride WatchKind? @map("kind_override")
  // Spec columns — diameter, lug-to-lug, crystal, movement — are deliberately
  // absent. The entity exists so they have somewhere to live, but extracting
  // them costs real model credit and nobody has asked to filter yet.
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  brand    Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants WatchVariant[]
  drops    Drop[]

  @@unique([brandId, key])
  @@unique([brandId, slug])
  @@index([brandId])
  @@map("watches")
}

// Where the grouping rule is wrong, and what it should say instead.
//
// ADR-0003 accepted a deliberately simple identity rule — brand plus normalised
// title — *on the condition* that corrections are cheap. A rule that simple is
// wrong sometimes: a store appending a reference to some products and not their
// siblings, two genuinely different models sharing a name, a limited edition
// that should stand apart. Without this table that trade-off does not hold,
// because the honest alternative would have been the expensive rule the project
// rejected.
//
// One row re-homes one store product. Both directions come from that: give two
// products the same `watch_key` to force a merge, give one its own to force a
// split. Editing rows is the whole interface — no deploy, no restart.
model WatchGroupingOverride {
  id      String @id @default(cuid())
  brandId String @map("brand_id")
  /// The store product being re-homed. Globally unique for the same reason a
  /// Variant is: a URL identifies exactly one thing in the world.
  productUrl String @unique @map("product_url")
  /// The identity key this product should group under, replacing the rule's.
  /// Products sharing one become one Watch.
  watchKey   String @map("watch_key")
  /// What the forced Watch is called, when the key is one the rule would never
  /// produce. Null means "use the name the rule derived for this product".
  watchName  String? @map("watch_name")
  /// Why, for whoever finds this in a year. Overrides outlive their reasons.
  note       String?
  /// Last poll this actually matched a product. Null long after `createdAt`
  /// means the store changed and the override is now doing nothing — the
  /// "harmless but discoverable" case rather than a silent no-op.
  lastMatchedAt DateTime? @map("last_matched_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@map("watch_grouping_overrides")
}

// One buyable configuration of a Watch — a bracelet option, a dial sold as its
// own store product. A facet of the watch, never an event.
model WatchVariant {
  id      String @id @default(cuid())
  watchId String @map("watch_id")
  // Globally unique, not per-watch: a product URL identifies exactly one thing
  // in the world, and keying on it is what lets a re-poll update a variant in
  // place — and lets a retitled product move to a different Watch rather than
  // being duplicated under both.
  productUrl String  @unique @map("product_url")
  reference  String?
  price      Decimal? @db.Decimal(12, 2)
  currency   String?  @db.VarChar(3)
  imageUrl   String?  @map("image_url")
  available  Boolean  @default(true)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @updatedAt @map("last_seen_at")

  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([watchId])
  @@map("watch_variants")
}

model Drop {
  id               String           @id @default(cuid())
  brandId          String           @map("brand_id")
  /// Which Watch this event is about. One release is one Drop however many
  /// references the store lists for it (ADR-0003).
  ///
  /// Nullable, and permanently so: a Drop extracted from a publication's RSS
  /// names a watch in prose and has no store product to tie it to, and the
  /// three YEMA Drops from 2026-08-06 predate Watches existing. History is
  /// assigned where it can be derived and left alone where it cannot — never
  /// merged, because deleting a Drop cascades the `drop_broadcasts` rows that
  /// are the only evidence its messages were sent (ADR-0002).
  watchId          String?          @map("watch_id")
  title            String
  type             DropType
  priceLow         Decimal?         @map("price_low") @db.Decimal(12, 2)
  priceHigh        Decimal?         @map("price_high") @db.Decimal(12, 2)
  currency         String?          @db.VarChar(3)
  eventDate        DateTime?        @map("event_date")
  // Ship date the brand promised at announcement. Captured now so the
  // reliability/delivery track-record score (CONTEXT.md §2) becomes possible
  // later — it needs promised-vs-actual history that only accrues over time.
  promisedShipDate DateTime?        @map("promised_ship_date")
  // Article media, extracted from the raw feed payload: thumbnail + link back
  // to the original coverage (attribution — we never copy article prose).
  imageUrl         String?          @map("image_url")
  sourceUrl        String?          @map("source_url")
  sourceEventId    String?          @map("source_event_id")
  // From LLM extraction (CONTEXT.md §5).
  confidenceScore  Float?           @map("confidence_score")
  moderationStatus ModerationStatus @default(pending) @map("moderation_status")
  reviewerId       String?          @map("reviewer_id")
  reviewedAt       DateTime?        @map("reviewed_at")
  publishedAt      DateTime?        @map("published_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  brand         Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  // SetNull, never Cascade: a Watch is a grouping we derived and may regroup,
  // and losing the announcement because we changed our mind about which model
  // it belonged to would destroy broadcast evidence along with it.
  watch         Watch?             @relation(fields: [watchId], references: [id], onDelete: SetNull)
  sourceEvent   RawIngestionEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  reviewer      User?              @relation("DropReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  notifications NotificationLog[]
  broadcasts    DropBroadcast[]

  @@index([brandId])
  @@index([watchId])
  @@index([moderationStatus])
  @@index([publishedAt])
  @@map("drops")
}

// ── Users, alerts, billing ───────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  displayName  String?  @map("display_name")
  planTier     PlanTier @default(free) @map("plan_tier")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  watchlists           Watchlist[]
  notificationChannels NotificationChannel[]
  notifications        NotificationLog[]
  subscription         Subscription?
  reviewedDrops        Drop[]                @relation("DropReviewer")

  @@map("users")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  brandId   String?  @map("brand_id")
  keyword   String?
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([brandId])
  @@map("watchlists")
}

model NotificationChannel {
  id         String                  @id @default(cuid())
  userId     String                  @map("user_id")
  type       NotificationChannelType
  identifier String
  verified   Boolean                 @default(false)
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, identifier])
  @@index([userId])
  @@map("notification_channels")
}

model NotificationLog {
  id      String                  @id @default(cuid())
  userId  String                  @map("user_id")
  dropId  String                  @map("drop_id")
  channel NotificationChannelType
  sentAt  DateTime                @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  drop Drop @relation(fields: [dropId], references: [id], onDelete: Cascade)

  // Dedup guard — one notification per (user, drop, channel) (CONTEXT.md §5).
  @@unique([userId, dropId, channel])
  @@index([dropId])
  @@map("notifications_log")
}

// Public broadcast log — one row per (drop, Telegram channel).
//
// `notifications_log` above deduplicates *per-user* alerts and so is keyed on a
// user. The UA and EN channels are public broadcasts that belong to nobody, so
// they need their own log; the unique constraint below is what makes "posted at
// most once, ever" true rather than merely intended. A row is written *before*
// the send is attempted, so a crash mid-run can only ever lose a message —
// never repeat one, which is the failure that gets a channel muted.
//
// Keyed on the chat id rather than the locale: a channel's identity is the chat
// it posts to, so pointing a locale at a different channel (a test channel
// swapped for the real one, a typo corrected) correctly counts as never having
// been broadcast there.
model DropBroadcast {
  id        String          @id @default(cuid())
  dropId    String          @map("drop_id")
  // The channel *key*, which for a plain chat is its chat id — every row
  // written before partner groups existed, and every channel of ours still.
  // A forum topic appends `:topic`, because two topics of one supergroup share
  // a chat id and posting to one must not count as posting to the other. See
  // `alerts/destinations.ts`.
  chatId    String          @map("chat_id")
  // Deliberately a string, not an enum, unlike every other closed set in this
  // schema. The point of the template design is that adding a language is a
  // translation and nothing else; an enum would make it a schema migration too.
  // The closed set that matters is enforced in TypeScript, by `AlertLocale`.
  locale    String          @db.VarChar(8)
  status    BroadcastStatus @default(pending)
  messageId String?         @map("message_id")
  error     String?
  createdAt DateTime        @default(now()) @map("created_at")
  sentAt    DateTime?       @map("sent_at")

  drop Drop @relation(fields: [dropId], references: [id], onDelete: Cascade)

  @@unique([dropId, chatId])
  @@index([dropId])
  @@map("drop_broadcasts")
}

// Weekly-digest email capture (CONTEXT.md §7.4) — lightweight, no account.
model DigestSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  unsubscribeToken String    @unique @default(uuid()) @map("unsubscribe_token")
  unsubscribedAt   DateTime? @map("unsubscribed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("digest_subscribers")
}

// Audit log of digest sends — also the double-send guard.
model DigestSend {
  id             String   @id @default(cuid())
  sentAt         DateTime @default(now()) @map("sent_at")
  dropCount      Int      @map("drop_count")
  recipientCount Int      @map("recipient_count")
  dryRun         Boolean  @default(false) @map("dry_run")

  @@map("digest_sends")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  plan                 PlanTier           @default(free)
  status               SubscriptionStatus @default(incomplete)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ── Views ────────────────────────────────────────────────────────────────
// moderation_queue — pending drops awaiting human review (CONTEXT.md §5).
// The backing SQL view is created in a dedicated migration; this block gives
// the Prisma Client a typed, read-only model over it.

view ModerationQueue {
  id               String           @unique
  brandId          String           @map("brand_id")
  title            String
  type             DropType
  confidenceScore  Float?           @map("confidence_score")
  moderationStatus ModerationStatus @map("moderation_status")
  reviewerId       String?          @map("reviewer_id")
  reviewedAt       DateTime?        @map("reviewed_at")
  publishedAt      DateTime?        @map("published_at")
  createdAt        DateTime         @map("created_at")

  @@map("moderation_queue")
}
