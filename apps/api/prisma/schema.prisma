// Crown Watch data model — see CONTEXT.md §5.
// Table/column names are snake_case (mapped) to match the brief; Prisma model
// and field names stay camelCase for idiomatic client usage.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum SourceType {
  rss
  newsletter
  kickstarter
  site_watch
  manual
}

enum SourceHealth {
  unknown
  healthy
  degraded
  error
}

enum BrandStatus {
  watchlist
  verified
}

enum DropType {
  kickstarter_launch
  waitlist_open
  restock
  pre_order
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum PlanTier {
  free
  paid
}

enum SubscriptionStatus {
  incomplete
  trialing
  active
  past_due
  canceled
}

enum NotificationChannelType {
  email
  telegram
  discord
}

enum BroadcastStatus {
  // Claimed but not yet resolved. A row left `pending` means the process died
  // between claiming and hearing back from Telegram — the message may or may
  // not have landed, so it is never retried (see DropBroadcast).
  pending
  sent
  failed
}

// ── Ingestion ────────────────────────────────────────────────────────────

model Source {
  id           String       @id @default(cuid())
  type         SourceType
  name         String?
  brandId      String?      @map("brand_id")
  endpoint     String
  // Tier 4 only: which store adapter to use and its settings, e.g.
  // { "adapter": "shopify_products_json", "currency": "EUR" }. Keeping this as
  // data means adding a brand on a supported platform needs no code change.
  watchConfig  Json?        @map("watch_config")
  lastPolledAt DateTime?    @map("last_polled_at")
  healthStatus SourceHealth @default(unknown) @map("health_status")
  // Politeness state. A store that errors or rate-limits us is asking to be
  // left alone for a while; persisting that request is what makes it survive a
  // restart, which an in-memory backoff would not.
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  nextAttemptAt       DateTime? @map("next_attempt_at")
  /// Why the source is unhealthy, so an operator can see it without logs.
  lastError           String?   @map("last_error")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  brand  Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  events RawIngestionEvent[]

  @@unique([type, endpoint])
  @@index([type])
  @@index([brandId])
  @@map("sources")
}

model RawIngestionEvent {
  id          String   @id @default(cuid())
  sourceId    String   @map("source_id")
  fetchedAt   DateTime @default(now()) @map("fetched_at")
  // Raw fetched content is never discarded — needed to reprocess as extraction
  // prompts improve (CONTEXT.md §5).
  rawPayload  Json     @map("raw_payload")
  contentHash String   @map("content_hash")
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  drops  Drop[]

  @@unique([sourceId, contentHash])
  @@index([processed])
  @@index([sourceId])
  @@map("raw_ingestion_events")
}

// ── Catalog ──────────────────────────────────────────────────────────────

model Brand {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  website          String?
  instagramHandle  String?     @map("instagram_handle")
  country          String?
  foundedYearEst   Int?        @map("founded_year_est")
  status           BrandStatus @default(watchlist)
  // Phase 2 — brand reliability / delivery track-record (CONTEXT.md §2, §5).
  reliabilityScore Float?      @map("reliability_score")
  // How many times the enrichment pass has asked a model about this brand.
  // Most brands will never have all three details — an obscure microbrand often
  // has no published founding year — so "still missing something" is not a
  // usable work queue on its own: the pass would re-ask about the same oldest
  // brands forever and never reach a newly discovered one. Counting attempts is
  // what lets it give up and move on.
  enrichmentAttempts  Int       @default(0) @map("enrichment_attempts")
  enrichmentAskedAt   DateTime? @map("enrichment_asked_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  sources    Source[]
  drops      Drop[]
  watchlists Watchlist[]

  @@index([status])
  @@map("brands")
}

model Drop {
  id               String           @id @default(cuid())
  brandId          String           @map("brand_id")
  title            String
  type             DropType
  priceLow         Decimal?         @map("price_low") @db.Decimal(12, 2)
  priceHigh        Decimal?         @map("price_high") @db.Decimal(12, 2)
  currency         String?          @db.VarChar(3)
  eventDate        DateTime?        @map("event_date")
  // Ship date the brand promised at announcement. Captured now so the
  // reliability/delivery track-record score (CONTEXT.md §2) becomes possible
  // later — it needs promised-vs-actual history that only accrues over time.
  promisedShipDate DateTime?        @map("promised_ship_date")
  // Article media, extracted from the raw feed payload: thumbnail + link back
  // to the original coverage (attribution — we never copy article prose).
  imageUrl         String?          @map("image_url")
  sourceUrl        String?          @map("source_url")
  sourceEventId    String?          @map("source_event_id")
  // From LLM extraction (CONTEXT.md §5).
  confidenceScore  Float?           @map("confidence_score")
  moderationStatus ModerationStatus @default(pending) @map("moderation_status")
  reviewerId       String?          @map("reviewer_id")
  reviewedAt       DateTime?        @map("reviewed_at")
  publishedAt      DateTime?        @map("published_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  brand         Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sourceEvent   RawIngestionEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  reviewer      User?              @relation("DropReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  notifications NotificationLog[]
  broadcasts    DropBroadcast[]

  @@index([brandId])
  @@index([moderationStatus])
  @@index([publishedAt])
  @@map("drops")
}

// ── Users, alerts, billing ───────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  displayName  String?  @map("display_name")
  planTier     PlanTier @default(free) @map("plan_tier")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  watchlists           Watchlist[]
  notificationChannels NotificationChannel[]
  notifications        NotificationLog[]
  subscription         Subscription?
  reviewedDrops        Drop[]                @relation("DropReviewer")

  @@map("users")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  brandId   String?  @map("brand_id")
  keyword   String?
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([brandId])
  @@map("watchlists")
}

model NotificationChannel {
  id         String                  @id @default(cuid())
  userId     String                  @map("user_id")
  type       NotificationChannelType
  identifier String
  verified   Boolean                 @default(false)
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, identifier])
  @@index([userId])
  @@map("notification_channels")
}

model NotificationLog {
  id      String                  @id @default(cuid())
  userId  String                  @map("user_id")
  dropId  String                  @map("drop_id")
  channel NotificationChannelType
  sentAt  DateTime                @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  drop Drop @relation(fields: [dropId], references: [id], onDelete: Cascade)

  // Dedup guard — one notification per (user, drop, channel) (CONTEXT.md §5).
  @@unique([userId, dropId, channel])
  @@index([dropId])
  @@map("notifications_log")
}

// Public broadcast log — one row per (drop, Telegram channel).
//
// `notifications_log` above deduplicates *per-user* alerts and so is keyed on a
// user. The UA and EN channels are public broadcasts that belong to nobody, so
// they need their own log; the unique constraint below is what makes "posted at
// most once, ever" true rather than merely intended. A row is written *before*
// the send is attempted, so a crash mid-run can only ever lose a message —
// never repeat one, which is the failure that gets a channel muted.
//
// Keyed on the chat id rather than the locale: a channel's identity is the chat
// it posts to, so pointing a locale at a different channel (a test channel
// swapped for the real one, a typo corrected) correctly counts as never having
// been broadcast there.
model DropBroadcast {
  id        String          @id @default(cuid())
  dropId    String          @map("drop_id")
  // The channel *key*, which for a plain chat is its chat id — every row
  // written before partner groups existed, and every channel of ours still.
  // A forum topic appends `:topic`, because two topics of one supergroup share
  // a chat id and posting to one must not count as posting to the other. See
  // `alerts/destinations.ts`.
  chatId    String          @map("chat_id")
  // Deliberately a string, not an enum, unlike every other closed set in this
  // schema. The point of the template design is that adding a language is a
  // translation and nothing else; an enum would make it a schema migration too.
  // The closed set that matters is enforced in TypeScript, by `AlertLocale`.
  locale    String          @db.VarChar(8)
  status    BroadcastStatus @default(pending)
  messageId String?         @map("message_id")
  error     String?
  createdAt DateTime        @default(now()) @map("created_at")
  sentAt    DateTime?       @map("sent_at")

  drop Drop @relation(fields: [dropId], references: [id], onDelete: Cascade)

  @@unique([dropId, chatId])
  @@index([dropId])
  @@map("drop_broadcasts")
}

// Weekly-digest email capture (CONTEXT.md §7.4) — lightweight, no account.
model DigestSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  unsubscribeToken String    @unique @default(uuid()) @map("unsubscribe_token")
  unsubscribedAt   DateTime? @map("unsubscribed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("digest_subscribers")
}

// Audit log of digest sends — also the double-send guard.
model DigestSend {
  id             String   @id @default(cuid())
  sentAt         DateTime @default(now()) @map("sent_at")
  dropCount      Int      @map("drop_count")
  recipientCount Int      @map("recipient_count")
  dryRun         Boolean  @default(false) @map("dry_run")

  @@map("digest_sends")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  plan                 PlanTier           @default(free)
  status               SubscriptionStatus @default(incomplete)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ── Views ────────────────────────────────────────────────────────────────
// moderation_queue — pending drops awaiting human review (CONTEXT.md §5).
// The backing SQL view is created in a dedicated migration; this block gives
// the Prisma Client a typed, read-only model over it.

view ModerationQueue {
  id               String           @unique
  brandId          String           @map("brand_id")
  title            String
  type             DropType
  confidenceScore  Float?           @map("confidence_score")
  moderationStatus ModerationStatus @map("moderation_status")
  reviewerId       String?          @map("reviewer_id")
  reviewedAt       DateTime?        @map("reviewed_at")
  publishedAt      DateTime?        @map("published_at")
  createdAt        DateTime         @map("created_at")

  @@map("moderation_queue")
}
