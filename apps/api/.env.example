# Copy to apps/api/.env and adjust as needed.

NODE_ENV=development
PORT=3333
# Comma-separated browser origins allowed via CORS (e.g. your Vercel URL). Blank = allow all.
WEB_ORIGIN=
# Shared secret enabling the admin moderation endpoints (sent as x-admin-token). Blank = disabled.
ADMIN_TOKEN=

# Postgres — docker-compose maps the container to host :5434 (see docker-compose.yml)
DATABASE_URL="postgresql://crownwatch:crownwatch@localhost:5434/crownwatch?schema=public"

# Redis / BullMQ — reserved for future queue work (CONTEXT.md §3). Mapped to host :6380.
REDIS_URL="redis://localhost:6380"

# Tier 1 RSS ingestion (CONTEXT.md §4)
# Cron expression for the scheduled poll (6-field, seconds-first). Default: every 15 min.
RSS_POLL_CRON="0 */15 * * * *"
# Run one poll immediately on API boot (handy in dev).
RSS_POLL_ON_BOOT=false
RSS_USER_AGENT="CrownWatchBot/0.1 (+https://crown-watch.example; Tier1 RSS ingestion)"
RSS_TIMEOUT_MS=20000

# Tier 4 site-watch (CONTEXT.md §4). These requests go to brands' own stores —
# the shops this product depends on — so the bot names itself honestly and
# points somewhere a shop owner can reach a human. Do not disguise it as a
# browser: being blocked by these stores would end the product.
SITE_WATCH_USER_AGENT="CrownWatchBot/0.1 (+https://crownswatch.org/about-the-bot; Tier4 store watch)"
SITE_WATCH_TIMEOUT_MS=20000
# Stores change far less often than a news feed, and every poll is a request to
# somebody else's shop. Hourly, at five past.
SITE_WATCH_POLL_CRON="0 5 * * * *"
SITE_WATCH_POLL_ON_BOOT=false

# Anthropic — LLM extraction stage (CONTEXT.md §5). Extraction is skipped until a key is set.
ANTHROPIC_API_KEY=""
# claude-haiku-4-5 (default) is ~5x cheaper; claude-opus-4-8 for max quality.
ANTHROPIC_MODEL="claude-haiku-4-5"
EXTRACTION_MAX_ITEMS=25

# Error monitoring (optional). Create a free project at sentry.io and paste its
# DSN; blank = Sentry disabled entirely.
SENTRY_DSN=""

# Weekly digest sender (Resend, free tier). Without a key the digest composes
# (preview / dry-run) but does not send. Until a custom domain is verified in
# Resend, the resend.dev sender can only deliver to your own Resend account email.
RESEND_API_KEY=""
DIGEST_FROM="Crown Watch <onboarding@resend.dev>"
# Public URLs used inside the email (links + unsubscribe). PUBLIC_API_URL falls
# back to Render's RENDER_EXTERNAL_URL automatically.
PUBLIC_WEB_URL="https://crownswatch.org"
PUBLIC_API_URL=""

# Telegram drop broadcast (CONTEXT.md §2 — the alerting promise).
# Detected drops are posted to two public channels, one per language. Without a
# bot token or with no channels set, dispatch is skipped with a warning and
# ingestion still succeeds.
# Create the bot with @BotFather, then add it to each channel as an admin with
# "Post messages" permission.
TELEGRAM_BOT_TOKEN=""
# Channel identifiers — "@channelname" for a public channel, or the numeric chat
# id (e.g. -1001234567890) for a private one.
TELEGRAM_CHANNEL_UA=""
TELEGRAM_CHANNEL_EN=""
TELEGRAM_TIMEOUT_MS=15000
# Pause between drops when backfilling a channel with already-published drops.
# Telegram throttles bursts to roughly 20 messages a minute per channel.
TELEGRAM_BACKFILL_DELAY_MS=3000
