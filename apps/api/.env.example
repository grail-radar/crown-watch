# Copy to apps/api/.env and adjust as needed.

NODE_ENV=development
PORT=3333
# Comma-separated browser origins allowed via CORS (e.g. your Vercel URL). Blank = allow all.
WEB_ORIGIN=

# Postgres — docker-compose maps the container to host :5434 (see docker-compose.yml)
DATABASE_URL="postgresql://crownwatch:crownwatch@localhost:5434/crownwatch?schema=public"

# Redis / BullMQ — reserved for future queue work (CONTEXT.md §3). Mapped to host :6380.
REDIS_URL="redis://localhost:6380"

# Tier 1 RSS ingestion (CONTEXT.md §4)
# Cron expression for the scheduled poll (6-field, seconds-first). Default: every 15 min.
RSS_POLL_CRON="0 */15 * * * *"
# Run one poll immediately on API boot (handy in dev).
RSS_POLL_ON_BOOT=false
RSS_USER_AGENT="CrownWatchBot/0.1 (+https://crown-watch.example; Tier1 RSS ingestion)"
RSS_TIMEOUT_MS=20000

# Anthropic — for the downstream LLM extraction stage (CONTEXT.md §5). Not used by ingestion yet.
ANTHROPIC_API_KEY=""
